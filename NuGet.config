<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep every downloaded package inside the workspace so that the build is
         self-contained and does not depend on a writable user profile. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
    <add key="httpCachePath" value=".nuget/http" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
