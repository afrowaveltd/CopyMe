<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Afrowave.DiskMigrator.Platform.Windows</RootNamespace>
    <AssemblyName>Afrowave.DiskMigrator.Platform.Windows</AssemblyName>
    <!-- Windows-only P/Invoke; the assembly is still compiled on the Linux build
         host so that the whole solution can be built and unit-tested there. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA1416;CA1848;CA1305</NoWarn>
    <!-- Raw device I/O goes through ReadFile/WriteFile with fixed buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Afrowave.DiskMigrator.Core\Afrowave.DiskMigrator.Core.csproj" />
  </ItemGroup>

</Project>
